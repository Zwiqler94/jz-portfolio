{
  "name": "jz-portfolio",
  "version": "5.4.6",
  "repository": "https://github.com/Zwiqler94/jz-portfolio.git",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "artifactregistry-login": "npx google-artifactregistry-auth",
    "build": "npm run build:prod",
    "build:dev-local:watch": "npm run build:dev-local -- --watch",
    "build:dev-local": "ng build -c dev-local",
    "build:dev:watch": "npm run build:dev -- --watch",
    "build:dev": "ng build -c development",
    "build:function": "npm --prefix 'functions/' run build",
    "build:local:watch": "npm run build:local -- --watch",
    "build:local": "ng build -c local",
    "build:prod:watch": "npm run build:prod -- --watch",
    "build:prod": "ng build -c production",
    "changelog:rebuild": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 -n ./.changelog-config.mjs",
    "changelog:update": "tmp=$(mktemp) && conventional-changelog -p angular -r 1 -n ./.changelog-config.mjs > \"$tmp\" && cat CHANGELOG.md >> \"$tmp\" && mv \"$tmp\" CHANGELOG.md",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "e2e": "ng e2e",
    "format": "prettier --write ./ --cache",
    "lint:fix": "npm run lint:format",
    "lint:format": "npm run format && ng lint jz-portfolio --fix",
    "lint": "ng lint",
    "ng": "ng",
    "start:dev-local": "npx --yes http-server@14.1.1 --proxy http://localhost:8083? --cors -p 8083 dist/jz-portfolio-dev-local",
    "start:dev": "npx --yes http-server@14.1.1 --proxy http://localhost:8085? --cors -p 8085 dist/jz-portfolio-dev",
    "start:local": "npx --yes http-server@14.1.1 --proxy http://localhost:8081? --cors -p 8081 dist/jz-portfolio-local",
    "start:prod": "npx --yes http-server@14.1.1 --cors -p 8087 -c-1 dist/jz-portfolio",
    "test": "ng test",
    "test:release": "node --test scripts/release.test.mjs",
    "prepare": "husky || true"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.25",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.25",
    "@angular/localize": "^20.3.25",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/router": "^20.3.25",
    "@angular/service-worker": "^20.3.25",
    "@cloudinary/ng": "^2.1.6",
    "@cloudinary/url-gen": "^1.22.0",
    "@firebase/util": "^1.15.3",
    "@google-cloud/secret-manager": "^6.2.0",
    "@yusifaliyevpro/countries": "^5.2.3",
    "@zwiqler94/everything-lib": "^0.19.1",
    "cloudinary": "^2.10.1",
    "compression": "^1.8.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.10",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "ng-gallery": "^12.0.0",
    "ngx-colors": "^3.6.0",
    "ngx-editor": "^18.0.0",
    "node-forge": "^1.4.0",
    "nodemon": "^3.1.14",
    "object-hash": "^3.0.0",
    "pg": "^8.23.0",
    "pg-format": "^1.0.4",
    "pokenode-ts": "^1.20.0",
    "promise-polyfill": "^8.3.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-state": "^1.4.4",
    "quibble": "^0.9.2",
    "rxjs": "^7.8.2",
    "sinon": "^21.1.2",
    "tslib": "^2.8.1",
    "uuid": "^13.0.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.9",
    "@angular/build": "^20.3.29",
    "@angular/cli": "^20.3.29",
    "@angular/compiler-cli": "^20.3.25",
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@puppeteer/ng-schematics": "^0.8.0",
    "@types/babel__core": "^7.20.5",
    "@types/chromedriver": "~81.0.5",
    "@types/compression": "~1.8.1",
    "@types/eslint": "^9.6.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/events": "^3.0.3",
    "@types/inquirer": "^9.0.10",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@types/jasmine": "~5.1.15",
    "@types/jest": "^30.0.0",
    "@types/karma": "~6.3.9",
    "@types/karma-chrome-launcher": "~3.1.4",
    "@types/karma-coverage": "~2.0.3",
    "@types/karma-firefox-launcher": "~2.1.4",
    "@types/karma-jasmine": "~4.0.5",
    "@types/karma-jasmine-html-reporter": "^1.7.3",
    "@types/lodash-es": "~4.17.12",
    "@types/luxon": "^3.7.5",
    "@types/mocha": "~10.0.10",
    "@types/node": "^25.9.4",
    "@types/node-forge": "~1.3.14",
    "@types/nodemon": "^3.1.1",
    "@types/object-hash": "^3.0.6",
    "@types/path-browserify": "^1.0.3",
    "@types/pg": "^8.23.1",
    "@types/pg-format": "^1.0.5",
    "@types/promise-polyfill": "^6.0.6",
    "@types/sinon": "~21.0.1",
    "@types/uuid": "^11.0.0",
    "@types/web-animations-js": "~2.2.16",
    "angular-eslint": "20.7.0",
    "baseline-browser-mapping": "^2.11.17",
    "browserslist-ga-export": "^5.0.0",
    "chromedriver": "^142.0.3",
    "conventional-changelog-cli": "^5.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "latest",
    "eslint-plugin-jsdoc": "latest",
    "eslint-plugin-prefer-arrow": "latest",
    "husky": "^9.1.7",
    "inquirer": "^13.4.3",
    "jasmine-core": "~5.13.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-firefox-launcher": "^2.1.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "karma-safari-launcher": "^1.0.0",
    "lint-staged": "^16.4.0",
    "mocha": "11.8.0",
    "prettier": "^3.9.6",
    "puppeteer": "24.43.1",
    "ts-node": "~10.9.2",
    "typescript": "^5.9",
    "typescript-eslint": "^8.67.0",
    "wdio-chromedriver-service": "^8.1.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --cache --write"
    ],
    "*.{json,css,scss,html,md,yml,yaml}": [
      "prettier --cache --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "chromedriver@142.0.3": true,
    "edgedriver@5.6.1": true,
    "fsevents@2.3.3": true,
    "lmdb@3.4.2": true,
    "msgpackr-extract@3.0.4": true,
    "puppeteer@24.43.1": true,
    "@firebase/util@1.15.3": true,
    "esbuild@0.28.1": true,
    "core-js@3.50.0": true,
    "@parcel/watcher@2.6.0": true,
    "geckodriver@4.2.1": true,
    "protobufjs@7.6.6": true
  }
}
